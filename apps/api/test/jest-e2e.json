{
  "rootDir": ".",
  "testEnvironment": "node",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testMatch": ["<rootDir>/**/*.e2e-spec.ts"],
  "testPathIgnorePatterns": ["<rootDir>/boot"],
  "globalSetup": "<rootDir>/global-setup.js",
  "moduleFileExtensions": ["js", "json", "ts"],
  "transformIgnorePatterns": ["/node_modules/", "/dist-cjs/", "/dist/"],
  "testTimeout": 20000
}
